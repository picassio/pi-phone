{
    "name": "pi-phone",
    "version": "0.1.0",
    "description": "A single-user pi agent as one Android app, from Pi Pocket and pi-termux-mobile",
    "private": true,
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "start": "node src/server/main.ts",
        "check": "tsc --noEmit -p . && node scripts/check-web-imports.ts",
        "test": "node --test test/*.test.ts",
        "upstream": "node scripts/upstream.ts"
    },
    "dependencies": {
        "@earendil-works/chord": "1.3.0",
        "@earendil-works/pi-ai": "1.3.0",
        "@earendil-works/pi-codemode": "1.3.0",
        "@earendil-works/pi-coding-agent": "1.3.0",
        "@earendil-works/pi-durable": "1.3.0",
        "@earendil-works/pi-env": "1.3.0",
        "@mozilla/readability": "0.6.0",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/xterm": "6.0.0",
        "dompurify": "3.4.16",
        "htm": "3.1.1",
        "jiti": "2.7.0",
        "katex": "0.19.0",
        "linkedom": "0.18.13",
        "marked": "18.1.0",
        "markit-engine": "0.6.2",
        "pele": "1.6.0",
        "pi-para": "0.8.6",
        "preact": "11.0.1",
        "qrcode": "1.5.4",
        "turndown": "7.2.4",
        "undici": "8.10.2",
        "ws": "8.22.0"
    },
    "devDependencies": {
        "@openuidev/lang-core": "1.0.0",
        "@openuidev/react-lang": "1.0.0",
        "@types/node": "26.6.5",
        "@types/qrcode": "1.5.6",
        "@types/turndown": "5.0.6",
        "@types/ws": "8.18.1",
        "esbuild": "0.28.2",
        "lucide-react": "0.562.0",
        "maplibre-gl": "6.14.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "typescript": "6.0.3",
        "zod": "4.6.6"
    }
}
