{
	"name": "pi-phone",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "pi agent for Android: pi-durable server in Termux, React Native app",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
