{
    "name": "pi-phone",
    "version": "0.1.0",
    "description": "A single-user pi agent as one Android app, from Pi Pocket and pi-termux-mobile",
    "private": true,
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "start": "node src/server/main.ts",
        "check": "tsc --noEmit -p . && node scripts/check-web-imports.ts",
        "test": "node --test test/*.test.ts"
    },
    "dependencies": {
        "@earendil-works/chord": "1.1.0",
        "@earendil-works/pi-ai": "1.1.0",
        "@earendil-works/pi-codemode": "1.1.0",
        "@earendil-works/pi-coding-agent": "1.1.0",
        "@earendil-works/pi-durable": "1.1.0",
        "dompurify": "3.4.16",
        "htm": "3.1.1",
        "jiti": "2.7.0",
        "marked": "18.1.0",
        "preact": "11.0.1",
        "qrcode": "1.5.4",
        "undici": "8.10.2"
    },
    "devDependencies": {
        "@types/node": "26.6.5",
        "@types/qrcode": "1.5.6",
        "typescript": "6.0.3"
    }
}
