<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Dictation (Dictation.java): Android asks the person the first time the mic is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- A voice call with Pi (VoiceCallService.java, PP-191): the microphone in the background, the call's audio route.
         FOREGROUND_SERVICE_MICROPHONE and the service's type count from targetSdk 34; declared now. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <!-- Android 11 and later list only the services an app declares it looks for: the speech recognizer. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- The phone's text-to-speech engine: the device's voice for "Pi thinks" (Speech.java, PP-193). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="pi"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <service
            android:name=".PiService"
            android:exported="false" />

        <!-- A voice call with Pi going on: its notification (Mute, End), the microphone with the screen off. -->
        <service
            android:name=".VoiceCallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Phone control (PiAccessibility.java, PP-141): off until the owner turns it on in Android's Accessibility
             settings. Only the system may bind it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".PiAccessibility"
            android:label="@string/phone_control_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_control_service" />
        </service>

        <!-- The phone's digital assistant (PiAssistant.java, PP-146): offered in Settings › Default apps › Digital
             assistant app; the side key's sheet is PiAssistantSession. Only the system binds these. -->
        <service
            android:name=".PiAssistant"
            android:label="@string/assistant_label"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assistant" />
        </service>
        <service
            android:name=".PiAssistantSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- The assistant's recognition service, which Android requires of an assistant: it passes speech on to the
             phone's own recognizer (Recognizers.java). -->
        <service
            android:name=".PiRecognition"
            android:label="@string/assistant_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
